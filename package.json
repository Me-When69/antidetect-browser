{
  "name": "antidetect-app",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "description": "Facet — Ứng dụng desktop mã nguồn mở quản lý nhiều hồ sơ trình duyệt cô lập",
  "repository": {
    "type": "git",
    "url": "https://github.com/Me-When69/antidetect-browser.git"
  },
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run tests/unit",
    "test:coverage": "vitest run tests/unit --coverage",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e",
    "validate:devices": "node scripts/validate-devices.mjs",
    "perf:budget": "node scripts/perf/check-budget.mjs",
    "postinstall": "node -e \"console.log('Antidetect: skipping Playwright browser download (using system Chrome/Edge)')\""
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@hookform/resolvers": "^7.0.8",
    "@puppeteer/browsers": "^3.2.7",
    "@tanstack/react-virtual": "^3.14.28",
    "archiver": "^7.0.1",
    "archiver-zip-encrypted": "^2.0.0",
    "better-sqlite3": "^13.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fernet": "^0.3.3",
    "google-auth-library": "^11.3.4",
    "googleapis": "^190.0.0",
    "https-proxy-agent": "^9.1.0",
    "lucide-react": "^0.511.0",
    "otplib": "^13.6.0",
    "playwright-core": "1.65.1",
    "proxy-chain": "^3.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.92.0",
    "socks": "^2.8.11",
    "socks-proxy-agent": "^10.1.0",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.3.0",
    "tz-lookup": "^6.1.25",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@playwright/test": "1.65.1",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.15.19",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "3.2.7",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.11",
    "electron": "^36.3.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.1.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.1.4"
  }
}
